# Cấp quyền chạy cho gradlew (chỉ cần làm 1 lần, trên macOS/Linux)
chmod +x gradlew

# Build debug APK (bản thường để test)
./gradlew assembleDebug

# Build release APK (bản phát hành, cần ký signing)
./gradlew assembleRelease

# Build + cài luôn lên thiết bị/emulator đang kết nối
./gradlew installDebug

# Dọn sạch build cũ (khi gặp lỗi lạ, build lại từ đầu)
./gradlew clean

# Clean rồi build lại debug
./gradlew clean assembleDebug

# Chạy unit test
./gradlew test

# Build + chạy toàn bộ kiểm tra (test + lint)
./gradlew build